# ---------------------------------------------------------
# Server
# ---------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------
# MongoDB Atlas
# Create a free cluster at https://cloud.mongodb.com, add a
# database user + your IP to the access list, then paste the
# connection string below (include the database name).
# ---------------------------------------------------------
MONGO_URI=mongodb+srv://cdcadmin:cdc@kpriet2028@cdc-cluster.zhevha6.mongodb.net/?appName=cdc-cluster

# ---------------------------------------------------------
# JWT
# Use a long, random string in production (e.g. `openssl rand -hex 64`)
# ---------------------------------------------------------
JWT_SECRET=9c1c5b2a1d0f8e4b7f3a6d9e1c8a5b7f9d2e4c6a8b1f3d5e7c9a1b4d6e8f0a2
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------
# CORS — the deployed/local frontend origin
# ---------------------------------------------------------
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------
# File uploads
# ---------------------------------------------------------
MAX_RESUME_SIZE_MB=5
MAX_LOGO_SIZE_MB=2

# ---------------------------------------------------------
# One-time admin seed script (npm run seed:admin)
# Change these before running in production, then remove/rotate.
# ---------------------------------------------------------
SEED_ADMIN_NAME=CDC Administrator
SEED_ADMIN_EMAIL=admin@kpriet.ac.in
SEED_ADMIN_PASSWORD=Admin@123
